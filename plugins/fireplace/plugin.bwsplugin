{"kind":"boltworks-plugin-package","packageVersion":1,"manifest":{"kind":"boltworks-plugin","manifestVersion":1,"id":"bws-fireplace","name":"Fireplace","version":"0.1.0","description":"Optional isolated fireplace scene with saved mesh logs, adjustable fire audio and fullscreen viewing. No editor access. Custom BWS scene transfer is not implemented yet.","runtime":"sandbox-html","entry":"main.html","apiVersion":1,"enabled":false,"contributes":{"toolbar":"scenes","fullscreen":true}},"files":{"main.html":{"mediaType":"text/html","data":"<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>BWS Fireplace Playground</title><style>body{margin:0;background:#101719;color:#eee0c9;font:15px Georgia}header{position:absolute;inset:0 0 auto;padding:16px;background:linear-gradient(#101719ee,transparent);display:flex;gap:12px;align-items:center;flex-wrap:wrap}h1{font-size:21px;color:#efb66d;margin:0}small{display:block;font:10px monospace;color:#baad99}button,a{font:inherit;color:#eee0c9;padding:8px;border:1px solid #77654d;background:#202725;text-decoration:none;border-radius:3px;cursor:pointer}label{font-size:13px}input{width:85px;accent-color:#efb66d}canvas{display:block;width:100vw;height:100vh}footer{position:absolute;bottom:14px;left:20px;right:20px;color:#bdad96;font-size:12px;pointer-events:none}#status{float:right}select{font:inherit;color:#eee0c9;background:#202725;border:1px solid #77654d;padding:8px;border-radius:3px}header{z-index:2;max-height:42vh;overflow:auto}button:focus-visible,select:focus-visible,input:focus-visible{outline:2px solid #efb66d;outline-offset:3px}body.immersive header,body.immersive footer{display:none}body.immersive,body.immersive canvas{cursor:none}#enjoy{background:#7b391e;border-color:#df9b55}footer{line-height:1.5}@media(max-width:650px){header{padding:10px;gap:8px}h1{font-size:18px}label{font-size:12px}footer{bottom:8px;left:12px;font-size:10px}}</style></head><body><header><div><h1>Fireplace playground</h1><small>BWS / A QUIET MOMENT BY THE FIRE</small></div><button id=\"restart\">Restart</button><button id=\"fire\">Fire: ON</button><button id=\"pause\">Pause</button><button id=\"lights\">Firelight: ON</button><label>Fuel <input id=\"fuel\" type=\"range\" min=\".4\" max=\"1.6\" step=\".05\" value=\"1\"></label><label>Turbulence <input id=\"chaos\" type=\"range\" min=\"5\" max=\"35\" value=\"20\"></label><label>Light <input id=\"power\" type=\"range\" min=\"0\" max=\"5\" step=\"0.01\" value=\"1.4\" aria-label=\"Fire light strength\"><input id=\"powerValue\" type=\"number\" min=\"0\" max=\"5\" step=\"0.01\" value=\"1.40\" aria-label=\"Exact fire light strength\" style=\"width:64px\"></label><label>Logs <select id=\"logVariant\"><option value=\"oak\">Split oak</option><option value=\"birch\">Birch stack</option><option value=\"charred\" selected>Charred timber</option></select></label><button id=\"sound\" aria-pressed=\"false\">Sound: OFF</button><label>Volume <input id=\"volume\" type=\"range\" min=\"0\" max=\"1\" step=\".01\" value=\".45\"></label><label>Crackle <input id=\"crackleVolume\" type=\"range\" min=\"0\" max=\"1\" step=\".01\" value=\".3\" aria-label=\"Crackle volume\"></label><label>Fire rumble <input id=\"rumbleVolume\" type=\"range\" min=\"0\" max=\"1\" step=\".01\" value=\".65\" aria-label=\"Fire rumble volume\"></label><label>Fullscreen view <select id=\"enjoyView\"><option value=\"logs\">Logs &amp; flames</option><option value=\"hearth\">Whole fireplace</option></select></label><button id=\"enjoy\">Enjoy fullscreen</button></header><canvas></canvas><footer>Drag to look around · Scroll to zoom · Fullscreen hides all controls; Escape returns. Crackling audio is synthesized. Flames use a camera-facing fluid simulation.<span id=\"status\" role=\"status\"></span></footer><script>(()=>{var Zr={LEFT:0,MIDDLE:1,RIGHT:2,ROTATE:0,DOLLY:1,PAN:2},Or={ROTATE:0,PAN:1,DOLLY_PAN:2,DOLLY_ROTATE:3},pd=0,kc=1,yd=2;var yu=1,So=2,Mn=